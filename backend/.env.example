# Node runs separately from Apache. Start MySQL in the XAMPP Control Panel.
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=spendtracker_api
DB_USER=spendtracker_app
DB_PASSWORD=replace-with-a-random-password
# Used only by npm run db:init, never by the running API.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
# Optional exact Flutter web origin; native Android does not need CORS.
WEB_ORIGIN=
